# Copy to deploy/.env before starting the local shard cluster.
POSTGRES_USER=antsql
POSTGRES_PASSWORD=change-me-before-any-shared-deployment
POSTGRES_DB=antsql

# Host ports intentionally differ so all three PostgreSQL shards can run on
# one development machine.
ANTSQL_SHARD_0_PORT=5433
ANTSQL_SHARD_1_PORT=5434
ANTSQL_SHARD_2_PORT=5435
